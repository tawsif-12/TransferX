# Database Connection
# Choose ONE option based on your database:

# OPTION 1: SQL Server / MSSQL (Current Configuration)
# For SQL Server Express with Windows Authentication (Recommended):
DATABASE_URL="sqlserver://localhost\SQLEXPRESS;database=transferx;integratedSecurity=true;trustServerCertificate=true;encrypt=true"

# For SQL Server Express with SQL Authentication:
# DATABASE_URL="sqlserver://localhost\SQLEXPRESS;database=transferx;user=sa;password=YourPassword;trustServerCertificate=true;encrypt=true"

# For Default SQL Server Instance:
# DATABASE_URL="sqlserver://localhost:1433;database=transferx;integratedSecurity=true;trustServerCertificate=true;encrypt=true"

# OPTION 2: MySQL (requires schema change to provider = "mysql")
# DATABASE_URL="mysql://root:password@localhost:3306/transferx"

# OPTION 3: PostgreSQL (requires schema change to provider = "postgresql")
# DATABASE_URL="postgresql://postgres:password@localhost:5432/transferx"

# JWT Secret (use a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Node Environment
NODE_ENV="development"

# API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3001"
