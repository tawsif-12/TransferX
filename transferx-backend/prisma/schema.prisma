// Prisma schema file for TransferX with SQL Server
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// MODELS

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  fullName      String?
  role          String    @default("PLAYER") // PLAYER, AGENT, CLUB_MANAGER, ADMIN
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  playerProfile PlayerProfile?
  agentProfile  AgentProfile?

  @@index([email])
  @@index([role])
  @@map("User")
}

model PlayerProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  position        String    // GOALKEEPER, DEFENDER, MIDFIELDER, FORWARD
  nationality     String?
  dateOfBirth     DateTime?
  height          Float?
  weight          Float?
  preferredFoot   String?
  currentClubId   Int?
  marketValue     Float     @default(0)
  goalsScored     Int       @default(0)
  assists         Int       @default(0)
  appearances     Int       @default(0)
  rating          Float     @default(0)
  bio             String?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentClub     Club?     @relation(fields: [currentClubId], references: [club_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PlayerProfile")
}

model AgentProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  agency          String?
  licenseNumber   String?
  yearsExperience Int       @default(0)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AgentProfile")
}

model League {
  league_id Int     @id @default(autoincrement())
  name      String
  country   String

  clubs     Club[]

  @@index([country])
}

model Club {
  club_id      Int     @id @default(autoincrement())
  league_id    Int
  name         String
  country      String
  founded_year Int?

  league       League  @relation(fields: [league_id], references: [league_id], onDelete: NoAction, onUpdate: NoAction)

  players      Player[]
  playerProfiles PlayerProfile[]
  transfers_from Transfer[] @relation("FromClub")
  transfers_to Transfer[] @relation("ToClub")
  contracts    Contract[]

  @@index([league_id])
  @@index([country])
}

model Player {
  player_id      Int     @id @default(autoincrement())
  first_name     String
  last_name      String
  date_of_birth  DateTime
  position       String?
  nationality    String?
  current_club_id Int?
  fee            Decimal?

  current_club   Club?   @relation(fields: [current_club_id], references: [club_id], onDelete: SetNull, onUpdate: NoAction)

  transfers_from Transfer[] @relation("PlayerTransfer")
  transfer_history TransferHistory[]
  contracts      Contract[]
  agents         PlayerAgent[]

  @@index([current_club_id])
  @@index([nationality])
}

model Transfer {
  transfer_id   Int     @id @default(autoincrement())
  player_id     Int
  from_club_id  Int
  to_club_id    Int
  transfer_fee  Decimal?
  transfer_date DateTime
  transfer_type String  // PERMANENT, LOAN, FREE

  player        Player    @relation("PlayerTransfer", fields: [player_id], references: [player_id], onDelete: NoAction, onUpdate: NoAction)
  from_club     Club      @relation("FromClub", fields: [from_club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)
  to_club       Club      @relation("ToClub", fields: [to_club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)

  transfer_history TransferHistory[]

  @@index([player_id])
  @@index([from_club_id])
  @@index([to_club_id])
  @@index([transfer_date])
}

model TransferHistory {
  transfer_id Int
  player_id   Int
  fee         Decimal?

  transfer    Transfer  @relation(fields: [transfer_id], references: [transfer_id], onDelete: NoAction, onUpdate: NoAction)
  player      Player    @relation(fields: [player_id], references: [player_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([transfer_id, player_id])
  @@index([player_id])
}

model Contract {
  contract_id Int       @id @default(autoincrement())
  player_id   Int
  club_id     Int
  start_date  DateTime
  end_date    DateTime
  salary      Decimal?

  player      Player    @relation(fields: [player_id], references: [player_id], onDelete: NoAction, onUpdate: NoAction)
  club        Club      @relation(fields: [club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([player_id])
  @@index([club_id])
  @@index([start_date, end_date])
}

model Agent {
  agent_id    Int       @id @default(autoincrement())
  agent_name  String

  players     PlayerAgent[]

  @@index([agent_name])
}

model PlayerAgent {
  player_id Int
  agent_id  Int

  player    Player  @relation(fields: [player_id], references: [player_id], onDelete: Cascade)
  agent     Agent   @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  @@id([player_id, agent_id])
  @@index([agent_id])
}
